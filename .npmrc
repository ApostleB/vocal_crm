# 의존성의 설치 스크립트를 실행하지 않는다.
# better-sqlite3 는 binding.gyp 가 있어 npm 이 node-gyp rebuild 를 자동 실행하는데,
# 이미 미리 빌드된 바이너리(prebuilds/)를 쓰므로 필요 없고 Windows 에서 Python·VS 빌드 도구를 요구해 실패한다.
# 그래서 Electron 바이너리도 설치 때 받지 않는다 — dev·start 스크립트가 install-electron 으로 먼저 받는다(받았으면 건너뜀).
# npm run <스크립트> 는 그대로 동작한다.
ignore-scripts=true
